{
    "layer": "top",
    "position": "top",
    "height": 0,
    "spacing": 5,

    "modules-left": [
		"ext/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "cpu",
        "memory",
		"network",
        "pulseaudio",
    	"custom/power"
    ],

    "ext/workspaces": {
		"format": "{name}: {icon}",
		"on-click": "activate",
		"format-icons": {
		    "active": "",
			"default": ""
		},
		"sort-by-name": true
    },
	
    "custom/power": {
		"format" : "⏻",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "~/.config/waybar/power_menu.xml",
		"menu-actions": {
			"shutdown": "shutdown now",
			"reboot": "reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate"
		}
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%A %d %B %Y}</big>"
    },

    "network": {
        "format-wifi": "{essid}",	
        "format-ethernet": "ethernet",
        "format-disconnected": "Offline",
		"tooltip": false,
		"format-alt": "{ipaddr}",
		"on-click-middle": "nm-connection-editor"
    },

    "cpu": {
        "format": "CPU {usage}%",
        "tooltip": false,
        "on-click": "kitty --title btop-float -e btop"
    },

    "memory": {
        "format": "RAM {}%",
        "tooltip": false,
        "on-click": "kitty --title btop-float -e btop"
    },

    "pulseaudio": {
		"on-click": "pavucontrol",
        "on-click-middle": "amixer set Master toggle",
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 Muted",
        "scroll-step": 5,
        "format-icons": {
            "default": [
                "󰕿 ",
                "󰖀 ",
                "󰕾 "
            ]
        }
    }
}

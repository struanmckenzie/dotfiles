{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 5,

    "modules-left": [],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "network",
        "cpu",
        "memory",
        "pulseaudio"
    ],

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%A %d %B %Y}</big>"
    },

    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": "󰈀 Ethernet",
        "format-disconnected": "󰖪 Offline",
        "format-alt": "󰩟 {ipaddr}",
        "tooltip": false,
		"on-click-right": "nm-connection-editor"
    },

    "cpu": {
        "format": " {usage}%",
        "tooltip": false,
        "on-click": "kitty --title btop-float -e btop"
    },

    "memory": {
        "format": "󰍛 {}%",
        "tooltip": false,
        "on-click": "kitty --title btop-float -e btop"
    },

    "pulseaudio": {
		"on-click": "kitty --title alsam -e alsamixer",
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 Muted",
        "scroll-step": 2,
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        }
    }
}

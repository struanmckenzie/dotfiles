{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 5,

    "modules-left": [],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "network",
        "cpu",
        "memory",
        "pulseaudio",
        "backlight",
        "battery"
    ],

    "clock": {
        "format": " {:%H:%M}",
        "tooltip-format": "<big>{:%A %d %B %Y}</big>"
    },

    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": "󰈀 Ethernet",
        "format-disconnected": "󰖪 Offline",
        "format-alt": "󰩟 {ipaddr}",
        "tooltip": false
    },

    "cpu": {
        "format": " {usage}%",
        "tooltip": false,
        "on-click": "kitty -e btop"
    },

    "memory": {
        "format": "󰍛 {}%",
        "tooltip": false,
        "on-click": "kitty --title btop-float -e btop"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 Muted",
        "scroll-step": 2,
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        }
    },

    "backlight": {
        "format": "󰃠 {percent}%",
        "scroll-step": 5
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁼",
            "󰁾",
            "󰂂"
        ]
    }
}

{
    "layer": "top",
    "position": "top",
    "height": 0,
    "spacing": 5,

    "modules-left": [	
        "cpu",
        "memory",
	"network",
        "pulseaudio"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
    	"custom/poweroff"
    ],
	
    "custom/poweroff": {
	"format": "",
	"tooltip": false,
	"on-click": "kitty -e systemctl poweroff"
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%A %d %B %Y}</big>"
    },

    "network": {
        "format-wifi": "{essid}",	
        "format-ethernet": "Ethernet",
        "format-disconnected": "Offline",
	"tooltip": false,
	"format-alt": "{ipaddr}",
	"on-click-middle": "nm-connection-editor"
    },

    "cpu": {
        "format": "CPU {usage}%",
        "tooltip": false,
        "on-click": "kitty --title btop-float -e btop"
    },

    "memory": {
        "format": "RAM {}%",
        "tooltip": false,
        "on-click": "kitty --title btop-float -e btop"
    },

    "pulseaudio": {
	"on-click": "kitty --title alsam -e alsamixer",
        "on-click-middle": "amixer set Master toggle",
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 Muted",
        "scroll-step": 5,
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        }
    }
}
